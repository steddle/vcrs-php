#!/usr/bin/env php
<?php

use Steddle\Vcrs\Annex;
use Steddle\Vcrs\Canonical;
use Steddle\Vcrs\Check;
use Steddle\Vcrs\InvalidRegister;
use Steddle\Vcrs\Json;
use Steddle\Vcrs\Level;
use Steddle\Vcrs\Register;
use Steddle\Vcrs\Report;
use Steddle\Vcrs\Statement;
use Steddle\Vcrs\Vcrs;

foreach ([__DIR__.'/../vendor/autoload.php', __DIR__.'/../../../autoload.php', __DIR__.'/../../../../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

const USAGE = 'VCRS '.Vcrs::VERSION.": check a claimant register against the Verified Claimant Register Standard.\n".<<<'TXT'

  vcrs check <register.json> [--records=<records.csv>] [--json] [--expect=<expected.json>]
      Grade every record, measure coverage, compute the snapshot root and the manifest, and say whether the export is
      consistent, whether it verifies, and up to which level its conditions hold. With --expect, check every outcome
      against the file, as the example's expected.json states them.

  vcrs export <register.json> --records=<records.csv>
      Print the export as one JSON document, its records read from the spreadsheet.

  vcrs statement <register.json> [--records=<records.csv>] [--level=registered|identified|verified]
                 [--auditor-firm=<name> --auditor-standard=<standard>
                  --auditor-engagement=agreed_upon_procedures|assurance --auditor-date=<YYYY-MM-DD>] [--issued-on=<YYYY-MM-DD>]
      Draft the conformance statement as JSON. Without the auditor it is a draft.

  vcrs manifest <register.json> [--records=<records.csv>] [--json]
      Print the snapshot (one line per record: id and digest), its root and the manifest's digest, which is what is
      anchored in time. With --json, print the manifest itself.

  vcrs proof <register.json> --record=<id> [--records=<records.csv>]
      Print one record's line, its inclusion proof, the snapshot root and the manifest's digest as JSON, for the person
      the record is of.

  vcrs verify <proof.json> --root=<sha256:...>
  vcrs verify <proof.json> --manifest=<manifest.json>
      Check a proof from vcrs proof against the root, or against the root a manifest from vcrs manifest --json commits
      to, without the register.

Exit codes: 0 a level's conditions hold; 1 none does; 2 usage; 3 the input is not valid: a file that is missing or
invalid, a record the register does not hold, an option the register does not bear out; 4 the export is not
consistent; 5 it does not verify; 6 the outcomes differ from --expect; 70 the validator itself failed.

The annex is the one the register names.

TXT;

[$command, $path, $options] = arguments(array_slice($argv, 1));

if ($command === null || $path === null || ! in_array($command, ['check', 'export', 'statement', 'manifest', 'proof', 'verify'], true)) {
    fwrite(STDERR, USAGE);
    exit(2);
}

try {
    if ($command === 'verify') {
        exit(verify($path, $options));
    }

    $register = Register::read($path, $options['records'] ?? null);

    if ($command === 'export') {
        echo json_encode($register->document, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";

        exit(0);
    }

    $report = Check::run($register, Annex::load($register->data['annex']));

    exit(match ($command) {
        'check' => check($report, isset($options['json']), $options['expect'] ?? null),
        'statement' => statement($report, $options),
        'manifest' => manifest($report, isset($options['json'])),
        'proof' => proof($report, $options),
    });
} catch (InvalidRegister $invalid) {
    fwrite(STDERR, "The input is not valid:\n  ".implode("\n  ", $invalid->errors)."\n");
    exit(3);
} catch (InvalidArgumentException $invalid) {
    fwrite(STDERR, $invalid->getMessage()."\n");
    exit(3);
} catch (Throwable $error) {
    fwrite(STDERR, "The validator failed: {$error->getMessage()}\n");
    exit(70);
}

/**
 * 0 where a level's conditions hold, else 1; 4 where the export is not consistent, 5 where it does not verify.
 */
function outcome(Report $report): int
{
    return match (true) {
        ! $report->consistent() => 4,
        ! $report->verified() => 5,
        $report->level() === null => 1,
        default => 0,
    };
}

function check(Report $report, bool $json, string|true|null $expect): int
{
    if (is_string($expect)) {
        return against($report, $expect);
    }

    if ($json) {
        echo json_encode($report->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";

        return outcome($report);
    }

    $data = $report->data;
    $counts = $report->counts();
    $denominator = $data['denominator'];

    echo "{$data['representative']['name']}: {$data['action']['title']}\n";
    echo 'VCRS '.Vcrs::VERSION.', Annex '.strtoupper($report->annex->code).", reference date {$data['reference_date']}\n\n";
    echo 'Denominator: '.number($denominator['low']).($denominator['low'] === $denominator['high'] ? '' : ' to '.number($denominator['high']))." ({$denominator['source']}, {$denominator['as_of']})\n\n";

    if (isset($data['claims'])) {
        $claims = $data['claims'];
        echo "Represented claims: {$claims['currency']} ".number($claims['low']).($claims['low'] === $claims['high'] ? '' : ' to '.number($claims['high']))." ({$claims['method']})\n\n";
    }

    printf("  %-14s %10s   %s\n", 'Grade', 'Records', 'Coverage');

    foreach ($report->coverage() as $grade => $share) {
        printf("  %-14s %s   %s\n", "{$grade} or better", mb_str_pad(number($share['records']), 10, ' ', STR_PAD_LEFT), percent($share['low']).($share['low'] === $share['high'] ? '' : ' to '.percent($share['high'])));
    }

    printf("  %-14s %s\n", 'D, active', mb_str_pad(number($counts['D']), 10, ' ', STR_PAD_LEFT));
    printf("  %-14s %s\n\n", 'D, not active', mb_str_pad(number($counts['inactive']), 10, ' ', STR_PAD_LEFT));

    if ($report->reasons() !== []) {
        echo "Why records hold their grade:\n";

        foreach ($report->reasons() as $grade => $reasons) {
            foreach ($reasons as $reason => $count) {
                printf("  %s  %-24s %s\n", $grade, $reason, number($count));
            }
        }

        echo "\n";
    }

    echo "Snapshot root: {$report->root}\n";
    echo "Manifest: {$report->manifestDigest}\n\n";

    $level = $report->level();

    echo match (true) {
        ! $report->consistent() => "The export is not consistent, so it meets no level.\n",
        ! $report->verified() => "The export does not verify, so it meets no level.\n",
        default => 'Export conditions met for: '.($level === null ? 'no level' : ucfirst($level->value))."\n",
    };
    echo "The auditor's check, regeneration before each hearing and the representative's control are for the statement to attest.\n";

    $blocking = $report->blocking();

    if ($blocking !== []) {
        echo "\n";

        foreach (array_slice($blocking, 0, 20) as $finding) {
            echo "  ✗ {$finding['code']->value} at {$finding['pointer']}: {$finding['message']}\n";
        }

        if (count($blocking) > 20) {
            echo '  and '.(count($blocking) - 20)." more\n";
        }
    }

    return outcome($report);
}

/**
 * Every outcome the file states, against the check's: each record's grade, reasons and digest, the counts, the
 * coverage, the root, the manifest, the level, and the finding codes.
 */
function against(Report $report, string $path): int
{
    $expected = Json::decode((string) file_get_contents($path));
    $expected = json_decode(json_encode($expected, JSON_THROW_ON_ERROR), true, flags: JSON_THROW_ON_ERROR);
    $actual = [
        'records' => array_map(fn ($grading, $digest) => ['grade' => $grading->grade->value, 'reasons' => $grading->reasonCodes(), 'digest' => $digest], $report->gradings, $report->digests),
        'counts' => $report->counts(),
        'coverage' => $report->coverage(),
        'root' => $report->root,
        'manifest' => $report->manifestDigest,
        'consistent' => $report->consistent(),
        'verified' => $report->verified(),
        'level' => $report->level()?->value,
        'findings' => array_map(fn (array $finding) => $finding['code']->value, $report->findings),
    ];
    $actual['records'] = array_combine(array_keys($report->gradings), $actual['records']);
    $differences = [];

    foreach ($expected as $key => $value) {
        if (! array_key_exists($key, $actual)) {
            $differences[] = "{$key}: the check reports no such outcome.";
        } elseif ($actual[$key] != $value) {
            $differences[] = "{$key}: expected ".json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE).', the check gives '.json_encode($actual[$key], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE).'.';
        }
    }

    foreach ($differences as $difference) {
        echo "✗ {$difference}\n";
    }

    if ($differences === []) {
        echo '✓ Every outcome '.basename($path)." states: '".implode("', '", array_keys($expected))."'.\n";

        return 0;
    }

    return 6;
}

/**
 * @param  array<string, string|true>  $options
 */
function statement(Report $report, array $options): int
{
    if (outcome($report) !== 0) {
        fwrite(STDERR, match (outcome($report)) {
            4 => 'The export is not consistent',
            5 => 'The export does not verify',
            default => 'The register meets no level',
        }.", so it has no statement to make.\n");

        return outcome($report);
    }

    $level = isset($options['level']) ? Level::tryFrom((string) $options['level']) : null;

    if (isset($options['level']) && $level === null) {
        fwrite(STDERR, USAGE);

        return 2;
    }

    $auditor = isset($options['auditor-firm'])
        ? ['firm' => $options['auditor-firm'], 'standard' => $options['auditor-standard'] ?? '', 'engagement' => $options['auditor-engagement'] ?? '', 'report_date' => $options['auditor-date'] ?? '']
        : null;

    $statement = Statement::draft(
        $report,
        $level,
        $auditor,
        $options['issued-on'] ?? null,
    );

    echo json_encode($statement, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";

    return 0;
}

function manifest(Report $report, bool $json): int
{
    if (! $report->consistent()) {
        fwrite(STDERR, "The export is not consistent, so it has no one snapshot: check it first.\n");

        return 4;
    }

    if ($json) {
        echo json_encode($report->manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";

        return 0;
    }

    foreach (Canonical::lines($report->digests) as $line) {
        echo "{$line}\n";
    }

    echo "root {$report->root}\n";
    echo "manifest {$report->manifestDigest}\n";

    return 0;
}

/**
 * @param  array<string, string|true>  $options
 */
function proof(Report $report, array $options): int
{
    if (! is_string($options['record'] ?? null)) {
        fwrite(STDERR, USAGE);

        return 2;
    }

    echo json_encode([...Canonical::proof($report->digests, $options['record']), 'manifest' => $report->manifestDigest], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";

    return 0;
}

/**
 * @param  array<string, string|true>  $options
 */
function verify(string $path, array $options): int
{
    $root = $options['root'] ?? null;
    $under = null;

    if (is_string($options['manifest'] ?? null)) {
        $manifest = is_file($options['manifest']) ? Json::decode((string) file_get_contents($options['manifest'])) : null;
        $root = $manifest->records->root ?? null;

        if (! is_string($root)) {
            fwrite(STDERR, "{$options['manifest']} is not a manifest from vcrs manifest --json: it names no root.\n");

            return 3;
        }

        $under = Canonical::manifestDigest($manifest);
    }

    if (! is_string($root)) {
        fwrite(STDERR, USAGE);

        return 2;
    }

    $proof = is_file($path) ? json_decode((string) file_get_contents($path), true) : null;

    if (! is_string($proof['line'] ?? null) || ! is_int($proof['index'] ?? null) || ! is_int($proof['size'] ?? null) || ! is_array($proof['proof'] ?? null)) {
        fwrite(STDERR, "{$path} is not a proof from vcrs proof: it needs line, index, size and proof.\n");

        return 3;
    }

    if (! Canonical::includes($root, $proof['line'], $proof['index'], $proof['size'], $proof['proof'])) {
        echo "✗ The proof does not place '{$proof['line']}' under {$root}.\n";

        return 5;
    }

    echo "✓ '{$proof['line']}' is in the snapshot under {$root}.\n";

    if ($under !== null) {
        echo "  The manifest {$under} commits to that root: check its anchor's timestamp against this digest.\n";
    }

    return 0;
}

/**
 * @param  list<string>  $arguments
 * @return array{0: ?string, 1: ?string, 2: array<string, string|true>}
 */
function arguments(array $arguments): array
{
    $positional = [];
    $options = [];

    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--')) {
            [$name, $value] = explode('=', substr($argument, 2), 2) + [1 => true];
            $options[$name] = $value;
        } else {
            $positional[] = $argument;
        }
    }

    return [$positional[0] ?? null, $positional[1] ?? null, $options];
}

function number(int $value): string
{
    return number_format($value, 0, '.', "\u{00A0}");
}

/**
 * Coverage as Report rounds it, to four decimals, printed without rounding again.
 */
function percent(float $value): string
{
    return number_format($value, 4, '.', "\u{00A0}").'%';
}
